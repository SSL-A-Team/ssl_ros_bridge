<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ssl_ros_bridge</name>
  <version>0.0.0</version>
  <description>Provides nodes to bridge SSL league packets into a ROS system.</description>
  <maintainer email="matthew.barulic@gmail.com">Matthew Barulic</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>boost</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>rosbag2_cpp</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>ssl_league_msgs</depend>
  <depend>ssl_league_protobufs</depend>
  <depend>ssl_ros_bridge_msgs</depend>

  <test_depend>ament_lint_auto</test_depend>
  <!-- ament_lint_common bundles ament_cmake_copyright; depend on the other
       linters individually and re-add ament_cmake_copyright separately so
       CMakeLists.txt can call ament_copyright() with an explicit EXCLUDE
       for the two generator scripts (no per-file header, by project
       decision) while still enforcing it on the rest of the package. -->
  <test_depend>ament_cmake_copyright</test_depend>
  <test_depend>ament_cmake_cppcheck</test_depend>
  <test_depend>ament_cmake_cpplint</test_depend>
  <test_depend>ament_cmake_flake8</test_depend>
  <test_depend>ament_cmake_lint_cmake</test_depend>
  <test_depend>ament_cmake_pep257</test_depend>
  <test_depend>ament_cmake_uncrustify</test_depend>
  <test_depend>ament_cmake_xmllint</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
